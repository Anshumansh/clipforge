# Database (Postgres — Neon, Railway, and Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# AI providers (all optional — app runs in a free/mock mode without these)
# Script writing + highlight detection: OpenAI (paid) or Groq (free, groq.com) — either works,
# both use the same OpenAI-compatible chat completions format.
OPENAI_API_KEY=
GROQ_API_KEY=
# Voiceover: OpenAI TTS if OPENAI_API_KEY is set, otherwise falls back automatically to
# free Microsoft Edge neural voices (msedge-tts) — no key needed for that tier.
ELEVENLABS_API_KEY=
# B-roll: Pexels (free, pexels.com/api) — used for both real stock video and photos.
PEXELS_API_KEY=

# Render worker (Phase 3) -- both optional, sane defaults apply if unset.
# WORKER_CONCURRENCY defaults to 1 (not 2): the audit measured ~3.3GB peak
# RAM per render on a 7.6GB VPS, and an OOM has already happened there --
# raise this only after measuring real headroom in the worker container
# itself, never as a first move. WORKER_POLL_INTERVAL_MS defaults to 3000.
WORKER_CONCURRENCY=
WORKER_POLL_INTERVAL_MS=

# Trend Radar: YouTube Data API v3 key (console.cloud.google.com — free, 10k quota
# units/day). Separate from any OAuth client used for social publishing.
YOUTUBE_DATA_API_KEY=
# Shared secret the VPS cron job sends to trigger scheduled endpoints
# (Trend Radar ingestion, scheduled social posts) — any random string.
CRON_SECRET=

# Stripe (test mode). Create two recurring Prices in your Stripe dashboard
# (Creator $29/mo, Business $99/mo) and paste their price IDs below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_BUSINESS=

# Demo generation (anonymous, unauthenticated) -- both optional, sane
# defaults apply if unset. DEMO_GLOBAL_LIMIT_PER_DAY caps combined demo
# generations across ALL visitors per day (default 200), independent of the
# existing hardcoded per-IP limit -- protects against a botnet or shared-IP
# office from adding up to unbounded aggregate spend. DEMO_GENERATION_ENABLED
# is a kill switch: set to "false" to disable the whole demo feature (e.g.
# during a cost spike or to protect paid-customer queue capacity); any other
# value, or leaving it unset, keeps demos enabled.
DEMO_GLOBAL_LIMIT_PER_DAY=
DEMO_GENERATION_ENABLED=

# Shared secret the render worker sends when fetching its own job's source
# media from /api/media server-to-server (e.g. downloading an uploaded
# repurpose source video for local analysis) -- that request has no user
# session to authenticate with. Any random string; must match on the app
# and worker services (they already share this .env file).
INTERNAL_MEDIA_SECRET=

# Storage (S3-compatible — Cloudflare R2, AWS S3, etc.). The bucket stays
# private; the app serves media through /api/media using short-lived presigned
# URLs, so there's no "public access" bucket setting to configure.
# Leave all four blank for local dev: rendered media then falls back to writing
# into ./public/media, which is fine on your laptop but NOT in real hosting
# (that disk doesn't survive redeploys or scale past one instance).
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
