www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# Security headers (CSP, HSTS, X-Frame-Options, etc.) are set by the app
	# itself in next.config.js -- kept in one place, in code, next to the CSP
	# that has to know what the app actually loads, instead of split across
	# this file and there where they can silently drift out of sync.
	reverse_proxy app:3000
}
