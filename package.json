    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=cjs --outfile=dist-worker/index.cjs --external:@remotion/bundler --external:@remotion/renderer --external:@remotion/cli --external:remotion --external:esbuild --external:@tensorflow/tfjs-core --external:@tensorflow/tfjs-converter --external:@tensorflow/tfjs-backend-wasm --external:@tensorflow-models/blazeface --external:jpeg-js --external:@prisma/client",
    "worker": "npm run build:worker && node dist-worker/index.cjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
